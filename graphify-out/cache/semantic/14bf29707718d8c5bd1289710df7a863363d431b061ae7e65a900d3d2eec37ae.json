{"nodes": [{"id": "feat001_core_research", "label": "Feature 001: Hacking Idle Core \u2014 Research", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "svc_tick_manager", "label": "TickManager Service", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer-based tick at 1-second interval using InvokeRepeating (not per-frame Update). Maintains ITickable subscriber list. Chosen over per-frame accumulation to prevent GC pressure and framerate coupling."}, {"id": "svc_offline_income", "label": "OfflineIncomeCalculator Service", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On load, computes elapsedSeconds = (now - max(malware.installedAt, player.lastSave)) / TicksPerSecond, then income = elapsedSeconds * incomeRate. Full offline accrual, no cap. UTC timestamps prevent timezone drift."}, {"id": "svc_command_parser", "label": "CommandParser Service", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dictionary<string, ICommand> registry. Tokenizes input by whitespace; first token = verb. Command pattern isolates each verb for independent unit testing. Extended in feat003 with GetRegisteredVerbs() for autocomplete."}, {"id": "svc_save_system", "label": "SaveSystem Service", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON serialization via JsonUtility to Application.persistentDataPath/save.json. SaveData aggregate. Save triggered on quit, pause, and significant state changes."}, {"id": "svc_location_service", "label": "LocationService", "file_type": "document", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates Location+Networks+Devices from LocationConfigSO using deterministic seed (location ID as PRNG seed). Extended in feat002 with virtual GetCurrentLocation() for testability."}, {"id": "design_offline_income", "label": "Offline Income Calculation Design", "file_type": "rationale", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses max(installedAt, lastSave) to prevent over-counting for malware installed mid-session. UTC timestamps. Full offline accrual with no cap."}, {"id": "design_procedural_generation", "label": "Procedural Network Generation Design", "file_type": "rationale", "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Location ID used as PRNG seed for deterministic reproducible generation. LocationConfigSO defines distributions. Prevents hand-authoring every network while keeping saves reproducible."}], "edges": [{"source": "feat001_core_research", "target": "svc_tick_manager", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "feat001_core_research", "target": "svc_offline_income", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "weight": 1.0}, {"source": "feat001_core_research", "target": "entity_currency", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 3", "weight": 1.0}, {"source": "feat001_core_research", "target": "svc_command_parser", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 4", "weight": 1.0}, {"source": "feat001_core_research", "target": "svc_save_system", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 5", "weight": 1.0}, {"source": "feat001_core_research", "target": "svc_location_service", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 6", "weight": 1.0}, {"source": "svc_offline_income", "target": "entity_malware", "relation": "reads", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "weight": 1.0}, {"source": "svc_offline_income", "target": "entity_player", "relation": "modifies", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "weight": 1.0}, {"source": "design_procedural_generation", "target": "svc_location_service", "relation": "applied_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 6", "weight": 1.0}, {"source": "design_offline_income", "target": "svc_offline_income", "relation": "applied_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/research.md", "source_location": "Decision 2", "weight": 1.0}], "hyperedges": []}