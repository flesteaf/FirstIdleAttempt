{"nodes": [{"id": "feat001_core_spec", "label": "Feature 001: Hacking Idle Core \u2014 Spec", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "entity_network", "label": "Network (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A discoverable Wi-Fi network with an SSID, security level (open/WEP/WPA/WPA2), and a set of connected device IPs; belongs to a location. SecurityLevel enum drives crack command matching."}, {"id": "entity_device", "label": "Device (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A network-connected machine with IP/MAC address, firewall status, open ports, and optional active malware payload. Firewall must be DISABLED before malware injection."}, {"id": "entity_malware", "label": "Malware (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A payload injected into a device. Types: miner (passive income), bot (automation/contracts), spammer (spam contracts), ransomware (one-time payment). Miner/spammer accrue offline income."}, {"id": "entity_player", "label": "Player (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds virtual currency balance (Dictionary<CurrencyType, double>), unlocked tools, purchased upgrades, active/completed contracts, and lastSaveUtcTicks for offline income calculation."}, {"id": "entity_location", "label": "Location (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A virtual area containing a set of discoverable networks. Player moves by running scan without parameters. ID is integer seed for deterministic procedural generation."}, {"id": "entity_contract", "label": "Contract (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task with defined objectives, required capabilities (e.g. bot injection), and a currency reward. Types: DDOS, FileRetrieval, FacilitatedAttack. Gated by player capabilities."}, {"id": "entity_store_item", "label": "Store Item (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "Key Entities", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A purchasable upgrade \u2014 PC component (improves hardware stats) or software (unlocks or enhances commands). Purchases take effect immediately."}, {"id": "entity_currency", "label": "Currency (Game Entity)", "file_type": "document", "source_file": "specs/001-hacking-idle-core/spec.md", "source_location": "FR-016", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progressive multi-currency. Starts with Bitcoin; altcoins unlock via store upgrade milestones. double precision to avoid float loss at large idle numbers."}], "edges": [{"source": "feat001_core_spec", "target": "entity_network", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-hacking-idle-core/spec.md", "source